{
  "name": "smartquiz",
  "private": false,
  "homepage": "https://smartquiz.innovalogic.tech/",
  "version": "0.0.0",
  "description": "A modern JSON-powered quiz and study platform for exams, training, interviews, and awareness programs.",
  "license": "MIT",
  "keywords": [
    "quiz",
    "exam-prep",
    "training",
    "education",
    "cybersecurity-awareness",
    "react",
    "vite",
    "json"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5172",
    "dev": "vite",
    "build": "npm run docs:build && vite build",
    "postbuild": "node scripts/copy-spa-fallback.js",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap open android",
    "cap:ios": "npm run build && cap open ios",
    "validate:schema": "node scripts/validate-schemas.js",
    "test": "npm run validate:schema && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run validate:schema && vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173",
    "security:audit": "npm audit --audit-level=high",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "docs:build": "node scripts/build-docs-site.js",
    "docs:screenshots": "node scripts/capture-doc-screenshots.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@hookform/resolvers": "^4.1.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^12.4.7",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.87.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.15.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.6",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-check": "^4.9.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
